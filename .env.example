# ----- Google AI Studio (Gemini) -----
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# Chat / generation model
GEMINI_MODEL=gemini-2.5-flash

# Embedding model used during ingestion
EMBEDDING_MODEL=gemini-embedding-001

# ----- Vector store (ChromaDB) -----
# Inside docker-compose the host is the service name "chroma".
# When running scripts locally against the dockerized Chroma, use localhost + 8001.
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=papers

# ----- Persistence -----
# Path to the SQLite database file (mounted volume inside the container)
SQLITE_PATH=/data/sqlite/app.db

# Where downloaded PDFs are stored
PDF_DIR=/data/pdfs

# ----- API -----
API_PORT=8080
LOG_LEVEL=INFO
# Comma-separated list of origins allowed by CORS middleware.
# Example: CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=http://localhost:5173

# ----- Agent runtime -----
# Maximum tool-call iterations inside one agent loop
AGENT_MAX_STEPS=8
